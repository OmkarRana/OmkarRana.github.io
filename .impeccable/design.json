    {
      "name": "Project card",
      "kind": "card",
      "refersTo": "project-card",
      "description": "Tonal project container with a fine ring and no hover lift.",
      "html": "<article class=\"ds-card\"><div><h3>Label Detection</h3><p>Extracting label numbers from cement bags moving along a conveyor belt in video footage.</p></div><p>Used OpenCV to convert video to images and detect bags.</p><footer>Deep Learning · OpenCV · Python</footer></article>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:20px;overflow:hidden;padding:20px;border-radius:12px;background:var(--card,#171717);color:var(--card-foreground,#ededed);box-shadow:0 0 0 1px color-mix(in oklab,var(--foreground,#ededed) 10%,transparent);font:400 13px/1.75 'Geist Variable',sans-serif}.ds-card h3{margin:0;font-size:16px;font-weight:500;line-height:1.375}.ds-card p{margin:4px 0 0;color:var(--muted-foreground,#a0a0a0)}.ds-card footer{font-size:11px}"
    },
    {
      "name": "Disabled contact field",
      "kind": "input",
      "refersTo": "input",
      "description": "Explicitly disabled field from the unconnected contact form.",
      "html": "<label class=\"ds-field\">Your name<input class=\"ds-input\" placeholder=\"Name\" disabled /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;color:var(--foreground,#ededed);font:500 14px/20px 'Geist Variable',sans-serif}.ds-input{height:32px;min-width:0;padding:4px 10px;border:1px solid var(--input,#383838);border-radius:10px;background:transparent;color:var(--foreground,#ededed);font:400 16px/24px 'Geist Variable',sans-serif;transition:color 150ms,background-color 150ms,border-color 150ms}.ds-input::placeholder{color:var(--muted-foreground,#a0a0a0)}.ds-input:focus-visible{outline:2px solid var(--ring,#959595);outline-offset:5px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#959595) 50%,transparent)}.ds-input:disabled{cursor:not-allowed;opacity:.5;background:color-mix(in oklab,var(--input,#383838) 50%,transparent)}@media(min-width:768px){.ds-input{font-size:14px;line-height:20px}}@media(prefers-reduced-motion:reduce){.ds-input{transition:none}} :host-context(.dark) .ds-input{background:color-mix(in oklab,var(--input,#383838) 30%,transparent)} :host-context(.dark) .ds-input:disabled{background:color-mix(in oklab,var(--input,#383838) 80%,transparent)}"
    },
    {
      "name": "Inline navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Compact links remain inline at mobile widths.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#about\" aria-current=\"location\">Home</a><a href=\"#experience\">Work</a><a href=\"#projects\">Projects</a><a href=\"#resume\">Resume</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:10px}.ds-nav a{display:flex;align-items:center;min-height:44px;padding:0 8px;border-radius:8px;color:var(--muted-foreground,#a0a0a0);font:400 13px/19.5px 'Geist Variable',sans-serif;text-decoration:none;transition:color 150ms}.ds-nav a:hover,.ds-nav a[aria-current]{color:var(--foreground,#ededed)}.ds-nav a:focus-visible{outline:2px solid var(--ring,#959595);outline-offset:5px}@media(max-width:600px){.ds-nav{gap:2px}}@media(max-width:370px){.ds-nav a{padding-inline:7px;font-size:12px}}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none}}"
