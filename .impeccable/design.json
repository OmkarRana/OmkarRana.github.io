  "narrative": {
    "northStar": "The Quiet Engineering Profile",
    "overview": "A narrow personal document gives professional experience room to be read. The built interface draws on the supplied Aneesh reference through its neutral palette, small controls, initials avatars and restrained typography. It stays compact without turning the profile into a dashboard.\n\nLight and dark themes share the same geometry. Self-hosted Geist supplies every text role; tonal surfaces and precise spacing carry the hierarchy. Motion acknowledges an entrance or a control state, with immediate keyboard operation and reduced-motion opacity alternatives.",
    "keyCharacteristics": [
      "One centered reading column.",
      "Neutral surfaces with green reserved for employment and availability status.",
      "Compact shadcn components backed by Base UI.",
      "Softly squared controls and initials avatars.",
      "Visible focus and restrained, interruptible state feedback."
    ],
    "rules": [
      {
        "name": "The Status Color Rule",
        "body": "Use status green only for current employment and availability indicators.",
        "section": "colors"
      },
      {
        "name": "The One Typeface Rule",
        "body": "Use the same Geist family throughout; express hierarchy through size, weight, tone and spacing.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Preserve the page's tonal hierarchy and fine outlines when extending its existing surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse semantic theme properties and the same shadcn components.",
      "Do preserve the centered reading column and responsive gutters.",
      "Do keep green tied to current employment and availability.",
      "Do retain labeled controls, visible focus and reduced-motion behavior.",
      "Do make unavailable actions explicit, as with the disabled contact form."
    ],
    "donts": [
      "Don't add a separate display typeface to this interface.",
      "Don't replace compact controls with oversized promotional treatments.",
      "Don't add a portrait, company logo or project destination without supplied evidence.",
      "Don't imply that the contact placeholder sends messages."
    ]
  }
