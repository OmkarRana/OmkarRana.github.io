  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary control; the page currently shows this disabled inside the coming-soon form.",
      "html": "<button class=\"ds-primary\">Send message</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;background:var(--primary,#ededed);color:var(--primary-foreground,#111);font:500 14px/20px 'Geist Variable',sans-serif;transition:background-color 150ms cubic-bezier(.23,1,.32,1)}.ds-primary:hover{background:color-mix(in oklab,var(--primary,#ededed) 80%,transparent)}.ds-primary:focus-visible{outline:2px solid var(--ring,#959595);outline-offset:5px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#959595) 50%,transparent)}.ds-primary:disabled{pointer-events:none;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Download and email actions. The runtime dark theme adds a translucent input-color fill.",
      "html": "<button class=\"ds-outline\">Download <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3\"/></svg></button>",
      "css": ".ds-outline{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 8px 0 10px;border:1px solid var(--border,#2b2b2b);border-radius:10px;background:var(--background,#111);color:var(--foreground,#ededed);font:500 14px/20px 'Geist Variable',sans-serif;transition:background-color 150ms cubic-bezier(.23,1,.32,1)}.ds-outline:hover{background:var(--muted,#212121)}.ds-outline:focus-visible{outline:2px solid var(--ring,#959595);outline-offset:5px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#959595) 50%,transparent)}@media(prefers-reduced-motion:reduce){.ds-outline{transition:none}} :host-context(.dark) .ds-outline{border-color:var(--input,#383838);background:color-mix(in oklab,var(--input,#383838) 30%,transparent)} :host-context(.dark) .ds-outline:hover{background:color-mix(in oklab,var(--input,#383838) 50%,transparent)}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet resume action.",
      "html": "<a class=\"ds-ghost\" href=\"#resume\">View resume</a>",
      "css": ".ds-ghost{display:inline-flex;align-items:center;height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;background:transparent;color:var(--foreground,#ededed);font:500 14px/20px 'Geist Variable',sans-serif;text-decoration:none;transition:background-color 150ms cubic-bezier(.23,1,.32,1)}.ds-ghost:hover{background:var(--muted,#212121)}.ds-ghost:focus-visible{outline:2px solid var(--ring,#959595);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-ghost{transition:none}} :host-context(.dark) .ds-ghost:hover{background:color-mix(in oklab,var(--muted,#212121) 50%,transparent)}"
    },
    {
      "name": "Muted icon button",
      "kind": "button",
      "refersTo": "button-muted",
      "description": "Theme, social and experience disclosure controls.",
      "html": "<button class=\"ds-muted\" aria-label=\"Expand experience\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></button>",
      "css": ".ds-muted{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid transparent;border-radius:10px;background:transparent;color:var(--muted-foreground,#a0a0a0);transition:background-color 150ms cubic-bezier(.23,1,.32,1),color 150ms cubic-bezier(.23,1,.32,1)}.ds-muted:hover{background:var(--muted,#212121);color:var(--foreground,#ededed)}.ds-muted:focus-visible{outline:2px solid var(--ring,#959595);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-muted{transition:none}}"
    },
    {
      "name": "Text button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Wrapping credential link with no inset padding.",
      "html": "<a class=\"ds-text\" href=\"#credential\">Databricks Certified Data Engineer Associate</a>",
      "css": ".ds-text{display:inline-flex;align-items:center;gap:6px;padding:0;border:1px solid transparent;border-radius:10px;color:var(--foreground,#ededed);background:transparent;font:500 13px/20px 'Geist Variable',sans-serif;text-align:left;text-decoration:none;white-space:normal;transition:color 150ms cubic-bezier(.23,1,.32,1)}.ds-text:hover{color:var(--muted-foreground,#a0a0a0)}.ds-text:focus-visible{outline:2px solid var(--ring,#959595);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-text{transition:none}}"
